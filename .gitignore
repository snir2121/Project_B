# Patient data and trained models stay local.
# Everything under data/ is ignored except READMEs, .gitkeep placeholders and data/example_data/.
data/**
!data/**/
!data/**/README.md
!data/**/.gitkeep
!data/example_data/**
models/*
!models/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Patient data from previous projects (references)
docs/refs/*/data/
