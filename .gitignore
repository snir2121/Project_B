!data/**/README.md
!data/**/.gitkeep
models/*
!models/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

